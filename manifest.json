{
  "manifest_version": 3,
  "name": "PromptOptimizer",
  "version": "1.0.0",
  "description": "Tactile prompt engineering & optimization copilot powered by Google Gemini Flash.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "contextMenus",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Open PromptOptimizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
